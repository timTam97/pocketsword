//
// Prefix header for all source files of the 'PocketSword' target in the 'PocketSword' project
//
// As of SWORD_REMOVAL_PLAN.md Phase 5 step 11 that is ONE file:
// externals/MBProgressHUD/MBProgressHUD.m, the last Objective-C translation unit in
// the target. Swift ignores GCC_PREFIX_HEADER entirely, so nothing else sees this —
// the Swift mirrors of DLog / ALog are `dlog(_:)` / `alog(_:)` in
// Classes/AppConstants.swift.
//
// What used to be here and is gone with the C++:
//   * the SWORD knobs — `unix` / `__unix__` / `EXCLUDEXZ`, plus the commented-out
//     `_ICU_` / `_APPLE_IOS_` / `USELUCENE` / `CURLAVAILABLE`. CURLAVAILABLE was
//     deliberately never defined (the in-app module-download feature and InstallMgr's
//     CURL transports were removed, and their call sites compiled to null-returning
//     stubs); the rest configured externals/sword, deleted in step 10.
//   * the five ZipArchive/minizip `HAVE_*` defines (HAVE_INTTYPES_H, HAVE_PKCRYPT,
//     HAVE_STDINT_H, HAVE_WZAES, HAVE_ZLIB) — externals/ZipArchive went in step 10
//     too. Note this is NOT what makes zlib available to PSContentStore: that uses
//     the iOS SDK's own zlib Clang module via `import zlib`, which needs no defines.
//

#ifdef __OBJC__
    #import <Foundation/Foundation.h>
    #import <UIKit/UIKit.h>
#endif

// DLog is almost a drop-in replacement for NSLog
// DLog();
// DLog(@"here");
// DLog(@"value: %d", x);
// Unfortunately this doesn't work DLog(aStringVariable); you have to do this instead DLog(@"%@", aStringVariable);
#ifdef DEBUG
#	define DLog(fmt, ...) NSLog((@"%s [Line %d] " fmt), __PRETTY_FUNCTION__, __LINE__, ##__VA_ARGS__);
#else
#	define DLog(...)
#endif

// ALog always displays output regardless of the DEBUG setting
#define ALog(fmt, ...) NSLog((@"%s [Line %d] " fmt), __PRETTY_FUNCTION__, __LINE__, ##__VA_ARGS__);
